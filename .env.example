# ======================================================================
# API de CIENCIA Y DIOS (apps/api/.env). Copia este archivo a apps/api/.env
# ======================================================================
CDD_ENV=development

# --- Base de datos -----------------------------------------------------
# Local (docker compose up -d db):
CDD_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/cdd
# Supabase (Connect → Session pooler). Sustituye <ref>, <región> y <contraseña>:
# CDD_DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Auth: cómo verifica la API los tokens de sesión ----------
# Usa UNA de las dos opciones (Project Settings → JWT Keys):
#  a) Proyectos con claves de firma (recomendado):
# CDD_SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#  b) Proyectos con el secreto JWT clásico (Legacy JWT secret):
# CDD_SUPABASE_JWT_SECRET=
CDD_SUPABASE_URL=

# --- Acceso de desarrollo (solo funciona con CDD_ENV=development o test) ---
CDD_DEV_AUTH=true
CDD_DEV_JWT_SECRET=cambia-este-secreto-local-de-al-menos-32-caracteres

# --- Web que puede llamar a la API (CORS) -----------------------------
CDD_CORS_ORIGINS=["http://localhost:3000"]

# --- Gemini (LLM) · docs/GEMINI.md ------------------------------------
# Clave de Google AI Studio (https://aistudio.google.com/apikey). Vacía = agentes sin LLM (modo determinista).
CDD_GEMINI_API_KEY=
CDD_GEMINI_MODEL=gemini-2.5-flash
# Precios USD por millón de tokens: compruébalos en https://ai.google.dev/pricing (se usan para el control de gasto)
CDD_GEMINI_INPUT_USD_PER_MTOK=0.30
CDD_GEMINI_OUTPUT_USD_PER_MTOK=2.50

# Búsqueda semántica: local (léxica, gratis) o gemini (embeddings reales). Tras cambiar a gemini: python -m cdd.reembed
CDD_EMBEDDINGS_PROVIDER=local
CDD_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Fuentes académicas (dimensión 1: textos publicados · dimensión 2: expertos) ---
CDD_CONNECTORS_ENABLED=["openalex","crossref","europepmc","arxiv"]
# Clave gratuita de OpenAlex (necesaria para identificar expertos por índice h): https://openalex.org
CDD_OPENALEX_API_KEY=
# Tu correo (opcional) para el «polite pool» de Crossref/OpenAlex
CDD_CONTACT_EMAIL=
CDD_EXPERTS_MIN_H_INDEX=15

# --- Protección contra abusos (0 = sin límite) ---
CDD_RATE_LIMIT_PER_MINUTE=300
CDD_INVESTIGATIONS_PER_HOUR=10

# --- HARNESS ------------------------------------------------------------
CDD_RUN_WORKER_IN_API=true
