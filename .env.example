# ======================================================================
# API de CIENCIA Y DIOS (apps/api/.env). Copia este archivo a apps/api/.env
# ======================================================================
CDD_ENV=development

# --- Base de datos -----------------------------------------------------
# Local (docker compose up -d db):
CDD_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/cdd
# Supabase (Connect → Session pooler). Sustituye <ref>, <región> y <contraseña>:
# CDD_DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Auth: cómo verifica la API los tokens de sesión ----------
# Usa UNA de las dos opciones (Project Settings → JWT Keys):
#  a) Proyectos con claves de firma (recomendado):
# CDD_SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#  b) Proyectos con el secreto JWT clásico (Legacy JWT secret):
# CDD_SUPABASE_JWT_SECRET=
CDD_SUPABASE_URL=

# --- Acceso de desarrollo (solo funciona con CDD_ENV=development o test) ---
CDD_DEV_AUTH=true
CDD_DEV_JWT_SECRET=cambia-este-secreto-local-de-al-menos-32-caracteres

# --- Web que puede llamar a la API (CORS) -----------------------------
CDD_CORS_ORIGINS=["http://localhost:3000"]

# --- HARNESS ------------------------------------------------------------
CDD_RUN_WORKER_IN_API=true
CDD_CONNECTORS_ENABLED=[]
# Opcional (aún no lo usan los agentes)
CDD_ANTHROPIC_API_KEY=
