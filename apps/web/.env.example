# URL de la API del proyecto (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (Project Settings → API Keys / Data API) ---
# Deja estas dos vacías para usar el modo desarrollo sin Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Clave PÚBLICA: «Publishable key» (sb_publishable_...) o la «anon key» clásica (eyJ...).
# NUNCA pongas aquí la «Secret key» ni la «service_role»: todo lo NEXT_PUBLIC_ llega al navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Botones de acceso de desarrollo (Propietario / Usuario). Pon false al usar Supabase.
NEXT_PUBLIC_DEV_AUTH=true
